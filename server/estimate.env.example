# Configure in the SERVER host's secret manager. Never put values in dist/.
MIR_ESTIMATE_ENABLED=false
# Must be a mounted persistent PRIVATE volume, outside the GitHub Pages source.
MIR_ESTIMATE_DATA_DIR=/var/lib/mir-estimates
MIR_ESTIMATE_FROM=MIR <noreply@YOUR_VERIFIED_DOMAIN>
# Start with a real test mailbox controlled by MIR before production activation.
MIR_ESTIMATE_TO=YOUR_TEST_MAILBOX
MIR_ESTIMATE_PRIVATE_URL=https://revetementsmirweb.github.io/MIR/estimation-dossier.html
MIR_ESTIMATE_ALLOWED_ORIGINS=https://revetementsmirweb.github.io
MIR_ESTIMATE_RATE_SECRET=GENERATE_A_RANDOM_SERVER_SECRET
MIR_ESTIMATE_RATE_MAX=8
# Existing MIR Supabase project and its PUBLIC key. No service-role key needed.
MIR_ESTIMATE_SUPABASE_URL=https://gccltmaulvrnthrbnrpd.supabase.co
MIR_ESTIMATE_SUPABASE_PUBLIC_KEY=SET_THE_EXISTING_MIR_PUBLISHABLE_KEY
MIR_ESTIMATE_ORGANIZATION_ID=SET_THE_MIR_ORGANIZATION_UUID
# Comma-separated Supabase auth.users UUIDs for named adjointes with employee role.
# Verified admins of the configured organization have access; other employees do not.
MIR_ESTIMATE_STAFF_USER_IDS=SET_AUTHORIZED_ADJOINTE_UUID
RESEND_API_KEY=SET_SERVER_SIDE_ONLY
HOST=127.0.0.1
PORT=8787
